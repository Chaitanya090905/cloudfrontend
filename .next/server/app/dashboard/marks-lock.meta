{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/marks-lock/layout,_N_T_/dashboard/marks-lock/page,_N_T_/dashboard/marks-lock"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/marks-lock/__PAGE__",
    "/dashboard/marks-lock",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}
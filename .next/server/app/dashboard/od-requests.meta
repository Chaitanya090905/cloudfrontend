{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/od-requests/layout,_N_T_/dashboard/od-requests/page,_N_T_/dashboard/od-requests"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/od-requests/__PAGE__",
    "/dashboard/od-requests",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}